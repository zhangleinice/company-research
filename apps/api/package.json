{
  "name": "@company-research/api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint src tests",
    "format": "prettier --write src tests *.json *.mjs",
    "test:live": "RUN_SEC_LIVE=1 jest --runInBand tests/sec.live.spec.ts",
    "prestart": "npm run build",
    "prebuild": "npm run build --workspace=@company-research/shared && npm run db:generate",
    "prestart:dev": "npm run build --workspace=@company-research/shared && npm run db:generate",
    "pretypecheck": "npm run build --workspace=@company-research/shared && npm run db:generate",
    "pretest": "npm run build --workspace=@company-research/shared && npm run db:generate",
    "pretest:live": "npm run build --workspace=@company-research/shared && npm run db:generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.87",
    "@company-research/shared": "0.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "6.19.0",
    "ai": "^7.0.166",
    "cheerio": "^1.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^7.0.0",
    "yauzl": "^2.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "@types/yauzl": "2.10.3",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "prisma": "6.19.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "clearMocks": true
  }
}
