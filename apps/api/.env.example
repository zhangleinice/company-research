# 必填：将下面的邮箱替换为你的真实联系邮箱
SEC_USER_AGENT=company-research your-name@your-domain.com
SEC_TIMEOUT_MS=15000
PORT=3000

# 可选：Clash HTTP / Mixed 代理，不使用代理时留空
# SEC_PROXY_URL=http://127.0.0.1:7897

# 财务摘要与下载文件目录，默认 apps/api/data
SEC_DATA_DIR=data
# 全量 ZIP 下载超时，默认 30 分钟
SEC_DOWNLOAD_TIMEOUT_MS=1800000

# PostgreSQL: replace username/password as needed
DATABASE_URL="postgresql://rocky@localhost:5432/company_research?schema=public"

# 可选：仅后端固定 10-K AI 分析使用；不要配置为 VITE_*
ROUTER_API_KEY=your-router-api-key
ROUTER_BASE_URL=https://api.router.ai/v1
AI_MODEL=gpt-6.1-sol
