# 必填：将下面的邮箱替换为你的真实联系邮箱
SEC_USER_AGENT=company-research your-name@your-domain.com
SEC_TIMEOUT_MS=15000
PORT=3000

# 可选：Clash HTTP / Mixed 代理，不使用代理时留空
# SEC_PROXY_URL=http://127.0.0.1:7897

# 财务摘要与下载文件目录，默认 apps/api/data
SEC_DATA_DIR=data
# 全量 ZIP 下载超时，默认 30 分钟
SEC_DOWNLOAD_TIMEOUT_MS=1800000

# PostgreSQL: replace username/password as needed
DATABASE_URL="postgresql://rocky@localhost:5432/company_research?schema=public"

# 可选：仅后端固定 10-K AI 分析使用；不要配置为 VITE_*
ROUTER_API_KEY=your-router-api-key
ROUTER_BASE_URL=https://api.router.ai/v1
AI_MODEL=gpt-6.1-sol

# 可选：并购列表，只在后端使用；当前套餐每次最多5条
FMP_API_KEY=your-fmp-api-key

# AI request timeout in milliseconds (1000–1800000); no automatic paid retry.
AI_REQUEST_TIMEOUT_MS=600000
AI_MAX_OUTPUT_TOKENS=32000
# Optional per-Item output budgets:
# AI_MAX_OUTPUT_TOKENS_ITEM_1=32000
# AI_MAX_OUTPUT_TOKENS_ITEM_1A=32000
# AI_MAX_OUTPUT_TOKENS_ITEM_7=32000

# Confirmed limits are required before paid whole-Item requests; unset blocks generation.
# JSON fields: model, provider, contextWindow, maxInputTokens, maxOutputTokens,
# byteFallbackTokenizer=true, source (verified evidence). Do not guess service limits.
AI_ITEM_LIMITS_JSON=
